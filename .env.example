# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
# Set to the number of reverse proxies in front of the API (0 = none).
TRUST_PROXY=0

AWS_REGION=us-east-1
# Local emulator (moto). Leave empty to use real AWS.
AWS_ENDPOINT_URL=http://localhost:5000
S3_FORCE_PATH_STYLE=true
# Dummy values for the emulator only. With real AWS use a profile or IAM role instead.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_BUCKET=remoteward-uploads
SQS_QUEUE_URL=http://localhost:5000/123456789012/remoteward-uploads
SQS_DLQ_URL=http://localhost:5000/123456789012/remoteward-uploads-dlq
SQS_VISIBILITY_TIMEOUT_SECONDS=120
SQS_MAX_RECEIVE_COUNT=3

REDIS_URL=redis://localhost:6379
JOB_STATUS_TTL_SECONDS=86400
JOB_RESULT_TTL_SECONDS=86400
JOB_LOCK_TTL_SECONDS=60

MAX_UPLOAD_BYTES=10485760
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
READ_RATE_LIMIT_MAX=60
READ_RATE_LIMIT_WINDOW_MS=60000

WORKER_CONCURRENCY=2
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_HEALTH_PORT=8080
